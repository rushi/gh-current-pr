#!/usr/bin/env bash
set -e

open_browser=false
url_only=false

usage() {
    echo "Usage: gh current-pr [--open] [--url]"
    echo ""
    echo "Prints the PR title, URL, merge status, last review, and failing or running checks for the current branch."
    echo ""
    echo "Flags:"
    echo "  --open   Open the PR in the browser"
    echo "  --url    Print only the PR URL (for scripting)"
    echo "  --help   Show this help"
}

for arg in "$@"; do
    case "$arg" in
        --open) open_browser=true ;;
        --url) url_only=true ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            echo "Unknown argument: $arg" >&2
            usage >&2
            exit 1
            ;;
    esac
done

# Colour only on a terminal, and never when NO_COLOR is set (https://no-color.org).
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    bold=$'\e[1m'
    red=$'\e[0;91m'
    reset=$'\e[0m'
else
    bold=""
    red=""
    reset=""
fi

branch=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ -z "$branch" ]; then
    echo "Error: not on a branch" >&2
    exit 1
fi

# Extract owner/repo from a git remote URL (supports both https and ssh)
extract_repo() {
    local url="$1"
    echo "$url" | sed -E 's|.*github\.com[:/]||; s|\.git$||'
}

# Branch name and fork owner the PR was opened from, taken from the tracking config.
# Falls back to the local branch name with no owner filter when nothing is tracked.
head_branch="$branch"
head_owner=""
tracking_repo=""
tracking_remote=$(git config "branch.$branch.remote" 2>/dev/null || true)
if [ -n "$tracking_remote" ] && tracking_url=$(git remote get-url "$tracking_remote" 2>/dev/null); then
    tracking_repo=$(extract_repo "$tracking_url")
    head_owner=${tracking_repo%%/*}
    merge_ref=$(git config "branch.$branch.merge" 2>/dev/null || true)
    head_branch=${merge_ref#refs/heads/}
    head_branch=${head_branch:-$branch}
fi

# Print "<repo> <number>" for the first PR in the repo whose head matches.
# `gh pr list --head` filters by branch name only, so the owner check stops
# a same-named branch on another contributor's fork from matching.
try_repo() {
    local repo="$1"
    local number
    number=$(gh pr list --repo "$repo" --head "$head_branch" --json number,headRepositoryOwner 2>/dev/null \
        | jq -r --arg owner "$head_owner" '
            map(select($owner == "" or (.headRepositoryOwner.login | ascii_downcase) == ($owner | ascii_downcase)))
            | .[0].number // empty
        ' 2>/dev/null || true)
    if [ -n "$number" ]; then
        echo "$repo $number"
        return 0
    fi
    return 1
}

# Find the repo and PR number for the branch. Outputs: "<repo> <number>"
find_pr_ref() {
    # 1. Try tracking remote
    if [ -n "$tracking_repo" ]; then
        try_repo "$tracking_repo" && return
    fi

    # 2. Try preferred remotes in order
    for remote in upstream origin; do
        local remote_url
        remote_url=$(git remote get-url "$remote" 2>/dev/null || true)
        [ -z "$remote_url" ] && continue
        try_repo "$(extract_repo "$remote_url")" && return
    done

    # 3. Try all remotes
    while IFS= read -r remote; do
        local remote_url
        remote_url=$(git remote get-url "$remote" 2>/dev/null || true)
        [ -z "$remote_url" ] && continue
        try_repo "$(extract_repo "$remote_url")" && return
    done < <(git remote)
}

pr_ref=$(find_pr_ref || true)

if [ -z "$pr_ref" ]; then
    echo "No pull request found for branch: $branch" >&2
    exit 1
fi

pr_repo=$(echo "$pr_ref" | cut -d' ' -f1)
pr_number=$(echo "$pr_ref" | cut -d' ' -f2)

# Fetch all details in one call
pr_json=$(gh pr view "$pr_number" --repo "$pr_repo" \
    --json title,url,isDraft,mergeable,mergeStateStatus,statusCheckRollup,reviews)

pr_title=$(echo "$pr_json" | jq -r '.title')
pr_url=$(echo "$pr_json" | jq -r '.url')

if [ "$url_only" = true ]; then
    echo "$pr_url"
    exit 0
fi
is_draft=$(echo "$pr_json" | jq -r '.isDraft')
mergeable=$(echo "$pr_json" | jq -r '.mergeable')
merge_state=$(echo "$pr_json" | jq -r '.mergeStateStatus')

# Merge status label
if [ "$is_draft" = "true" ]; then
    merge_label="Draft"
elif [ "$mergeable" = "CONFLICTING" ]; then
    merge_label="${red}Conflicts${reset}"
elif [ "$merge_state" = "BLOCKED" ]; then
    merge_label="${red}Blocked${reset}"
elif [ "$merge_state" = "CLEAN" ]; then
    merge_label="Ready to merge"
elif [ "$merge_state" = "BEHIND" ]; then
    merge_label="Behind base branch"
else
    merge_label="$merge_state"
fi

# statusCheckRollup mixes CheckRun items (.status, .conclusion) with
# StatusContext items from the commit status API (.state only).
failing_checks=$(echo "$pr_json" | jq -r '
    .statusCheckRollup[]?
    | select(
        (.status == "COMPLETED" and ((.conclusion // "") | ascii_downcase | IN("success", "skipped", "neutral") | not))
        or .state == "FAILURE"
        or .state == "ERROR"
      )
    | .name // .context
' 2>/dev/null || true)

pending_checks=$(echo "$pr_json" | jq -r '
    .statusCheckRollup[]?
    | select((.status | IN("IN_PROGRESS", "QUEUED", "PENDING")) or .state == "PENDING")
    | .name // .context
' 2>/dev/null || true)

# submittedAt is UTC. jq converts it to local time on both BSD and GNU systems.
last_review=$(echo "$pr_json" | jq -r '
    .reviews
    | map(select(.state != "PENDING"))
    | last
    | if . then
        .submittedAt as $at
        | "\(.author.login) at \($at | try (fromdateiso8601 | strflocaltime("%b %d, %Y %I:%M %p")) catch $at)"
      else "" end
' 2>/dev/null || true)

printf '%s%s%s\n' "$bold" "$pr_title" "$reset"
echo "$pr_url"
printf 'Merge: %s\n' "$merge_label"
if [ -n "$last_review" ]; then
    echo "Last review: $last_review"
fi

if [ -n "$failing_checks" ]; then
    echo "Failing checks:"
    while IFS= read -r check; do
        echo "  - $check"
    done <<< "$failing_checks"
fi

if [ -n "$pending_checks" ]; then
    echo "In progress:"
    while IFS= read -r check; do
        echo "  - $check"
    done <<< "$pending_checks"
fi

if [ "$open_browser" = true ]; then
    gh pr view "$pr_number" --repo "$pr_repo" --web
fi
